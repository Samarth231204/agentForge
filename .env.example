# Two interchangeable Groq keys — set GROQ_ACTIVE_KEY to 1 or 2 to pick which
# one is actually used, e.g. to switch once the active one hits its daily quota.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_ACTIVE_KEY=1
GROQ_MODEL=openai/gpt-oss-20b
# Final fallback chain, tried in order after every Groq model is exhausted
# (see llm_fallback.py). Comma-separated — free OpenRouter models are
# themselves rate-limited and occasionally get discontinued, so more than
# one backs each other up. Both the key and at least one model must be set
# for this to be used — leave blank until you have an OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,cohere/north-mini-code:free,inclusionai/ling-3.0-flash-fin:free,dots-studio/dots-3-note-preview:free,liquid/lfm-2.5-2.6b:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501
SANDBOX_BASE_PATH=/tmp/agentforge_sandbox
SANDBOX_IMAGE=agentforge-sandbox:local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional — unset means Gmail tokens live in process memory only (erased on
# backend restart). Set this to move them to Redis, where each token expires
# on its own TTL instead, sliding forward on every use.
REDIS_URL=
GMAIL_TOKEN_TTL_SECONDS=86400
# Optional — unset means agent memory recall and critic lessons are simply
# disabled (research/email requests run exactly as before). Free tier at
# https://app.mem0.ai.
MEM0_API_KEY=
