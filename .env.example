# Two interchangeable Groq keys — set GROQ_ACTIVE_KEY to 1 or 2 to pick which
# one is actually used, e.g. to switch once the active one hits its daily quota.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_ACTIVE_KEY=1
GROQ_MODEL=openai/gpt-oss-20b
# Final fallback after every Groq model is exhausted (see llm_fallback.py).
# Both must be set for it to be used — leave blank until you have an account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_BASE_URL=http://localhost:8000
STREAMLIT_PORT=8501
SANDBOX_BASE_PATH=/tmp/agentforge_sandbox
SANDBOX_IMAGE=agentforge-sandbox:local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional — unset means Gmail tokens live in process memory only (erased on
# backend restart). Set this to move them to Redis, where each token expires
# on its own TTL instead, sliding forward on every use.
REDIS_URL=
GMAIL_TOKEN_TTL_SECONDS=86400
# Optional — unset means agent memory recall and critic lessons are simply
# disabled (research/email requests run exactly as before). Free tier at
# https://app.mem0.ai.
MEM0_API_KEY=
