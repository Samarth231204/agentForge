# The Gmail relay's own environment. This machine is the ONLY place the
# Google client secret should exist.

# Same OAuth client as the server, but the server only gets the ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be byte-identical to the server's GOOGLE_REDIRECT_URI. The server
# puts this value in the consent URL; the relay sends it again during the
# code exchange, and Google rejects the pair if they differ at all.
GOOGLE_REDIRECT_URI=https://<your-tunnel-host>/auth/google/callback

# The shared Redis both the server and this relay reach. Tokens live here,
# so they never travel over the relay API.
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Shared with the server as GMAIL_RELAY_SECRET. Without it this service
# would be an open mail relay for anyone who finds the tunnel URL.
GMAIL_RELAY_SECRET=

RELAY_PORT=4100
